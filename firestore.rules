rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Firestore security rules — the COMPLETE ruleset for the Sweetardio project.
//
// This file covers every collection the site touches (After Hours Rx
// patient files, whitelist, both leaderboards, board posts, game config,
// marketplace listings) and is wired up for deployment via firebase.json:
//
//     npm run deploy:rules          # local (needs `firebase login` once)
//
// …or automatically by .github/workflows/firestore-rules.yml when this file
// changes on main (needs the FIREBASE_SERVICE_ACCOUNT repo secret).
// You can also paste it wholesale into Firebase console → Firestore → Rules.
//
// ⚠️  If you have added collections in the console that are NOT listed here,
//     add matching blocks before deploying — anything unmatched is denied.
// ─────────────────────────────────────────────────────────────────────────

// ===============================================================
// Assumed Data Model — rx_files (After Hours Rx patient files)
// ===============================================================
//
// Collection: rx_files
// Document ID: the patient's Firebase Auth uid
// Fields:
//   - uid: string (required, == document id, immutable)
//   - provider: string (required, == token sign_in_provider:
//       'twitter.com' | 'google.com' | 'password')
//   - email: string | null (== token email; PII, owner-only)
//   - xId: string | null (an X account id from the token's identities)
//   - xHandle: string | null (<= 40)
//   - answers: map (only medication / filled / allergies; each string <= 40 or null)
//   - notes: string (required, 1..250)
//   - wallet: string (required, 32..44, base58 Solana address)
//   - ref: string | null (<= 64, the ?ref= they arrived with)
//   - path: 'took' | 'spit' | null ('spit' is final)
//   - minted: bool (required; the patient's own claim)
//   - filedAt: timestamp (required, server time at SEND TO FILL)
//   - updatedAt: timestamp (required, == request.time on every write)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Whitelist signups ──────────────────────────────────────────────
    // Anyone may submit (no auth required). Reads are PUBLIC so The Board's
    // guest list can show who's whitelisted — note this makes every stored
    // wallet address and handle publicly queryable. If you'd rather keep the
    // list private again, set `allow read: if false;` (the guest-list section
    // on /board hides itself automatically when reads are denied).
    // Re-submitting the same wallet just overwrites the document (idempotent).
    match /whitelist/{wallet} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if isValidWhitelistSignup(wallet);
    }

    function isValidWhitelistSignup(walletId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['wallet', 'xHandle', 'submittedAt'])
        && d.wallet is string
        && d.wallet == walletId                       // doc id must equal the wallet
        && d.wallet.size() >= 32 && d.wallet.size() <= 44  // base58 Solana pubkey
        && (d.xHandle == null || (d.xHandle is string && d.xHandle.size() <= 40))
        && d.submittedAt == request.time;             // server timestamp only
    }

    // ── After Hours Rx patient files (COUNTER 4444 HAS YOUR FILE) ──────
    // One document per patient, keyed by their Firebase uid, written only by
    // that patient while signed in (X, Google, or email and password). Holds
    // the intake from the Rx pad, the silent ?ref= they arrived with, and
    // which way they went at the catch. Holds PII (email), so it is private:
    // only its owner can read it; the team reads the collection from the
    // console. Identity fields must match the sign-in token (sign-in method,
    // email, X account id), not whatever the client claims. Taking the meds
    // can be followed by spitting them out later; a spat file never goes
    // back. `minted` is the patient's own claim for the UI (FILE CLOSED), not
    // proof of anything — check the chain before rewarding a file.
    match /rx_files/{uid} {
      allow read: if isRxOwner(uid);
      allow create, update: if isRxOwner(uid) && isValidRxFile(uid);
      allow delete: if false;
    }

    function isRxOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isShortOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    // Validator for BOTH create and update: the whole document after the write.
    function isValidRxFile(uid) {
      let d = request.resource.data;
      let token = request.auth.token;
      let method = token.firebase.sign_in_provider;
      return method in ['twitter.com', 'google.com', 'password']
        && d.keys().hasOnly(['uid', 'provider', 'email', 'xId', 'xHandle', 'answers', 'notes', 'wallet', 'ref', 'path', 'minted', 'filedAt', 'updatedAt'])
        && d.keys().hasAll(['uid', 'provider', 'answers', 'notes', 'wallet', 'minted', 'filedAt', 'updatedAt'])
        && d.uid == uid                                                   // ownership is the doc id; can't be moved
        && d.provider == method                                           // from the token, not the client
        && d.get('email', null) == token.get('email', null)               // from the token, not the client
        && (d.get('xId', null) == null
            || d.xId in token.firebase.identities.get('twitter.com', []))   // the X account they signed in with
        && isShortOptionalString(d.get('xHandle', null), 40)
        && d.answers is map
        && d.answers.keys().hasOnly(['medication', 'filled', 'allergies'])
        && isShortOptionalString(d.answers.get('medication', null), 40)
        && isShortOptionalString(d.answers.get('filled', null), 40)
        && isShortOptionalString(d.answers.get('allergies', null), 40)
        && d.notes is string && d.notes.size() >= 1 && d.notes.size() <= 250
        && d.wallet is string && d.wallet.size() >= 32 && d.wallet.size() <= 44
        && isShortOptionalString(d.get('ref', null), 64)
        && (d.get('path', null) == null || d.path in ['took', 'spit'])
        && (resource == null || resource.data.get('path', null) != 'spit'
            || d.get('path', null) == 'spit')                             // spat is final
        && d.minted is bool
        && d.filedAt is timestamp
        && d.updatedAt == request.time;                                   // server timestamp only
    }

    // ── Arcade leaderboards ────────────────────────────────────────────
    // One document per player (keyed by wallet address, or an anonymous
    // free-play id). Publicly readable so the board renders for everyone.
    //
    // Anti-tamper posture (be honest about it): the games run entirely in the
    // browser, so a determined user can always call Firestore directly — a
    // client-written board can never be cryptographically tamper-proof
    // without a server. These rules instead BOUND the damage:
    //   • strict document shape + server-timestamp-only `updatedAt`
    //   • hard caps on every value (1e12)
    //   • rate limit: updates rejected within 2 s of the previous write
    //   • per-write delta caps: no single write can move score/balance/
    //     netProfit by more than 50 M (far above any legitimate jackpot,
    //     far below "type in a trillion")
    //   • score is monotonic — it can never be written downwards
    // Combined with the client HMAC on stored balances, casual DevTools
    // editing fails and scripted abuse is slow, capped, and obvious.
    // ALWAYS manually review top standings before paying out NFT-launch
    // rewards to specific wallets.
    match /leaderboard_slots/{player} {
      allow read: if true;
      allow create: if isValidLeaderboardEntry(player) && isSaneFirstEntry();
      allow update: if isValidLeaderboardEntry(player) && isSaneUpdate();
    }

    match /leaderboard_coinpusher/{player} {
      allow read: if true;
      allow create: if isValidLeaderboardEntry(player) && isSaneFirstEntry();
      allow update: if isValidLeaderboardEntry(player) && isSaneUpdate();
    }

    function isValidLeaderboardEntry(playerId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['player', 'name', 'score', 'balance', 'netProfit', 'updatedAt'])
        && d.player is string
        && d.player == playerId                        // doc id must equal the player key
        && d.player.size() >= 1 && d.player.size() <= 64
        && d.name is string && d.name.size() <= 24
        && d.score is int && d.score >= 0 && d.score <= 1000000000000
        && d.balance is int && d.balance >= 0 && d.balance <= 1000000000000
        && d.netProfit is int
        && d.netProfit >= -1000000000000 && d.netProfit <= 1000000000000
        && d.updatedAt == request.time;                // server timestamp only
    }

    // A brand-new row can't claim more than one monster jackpot's worth.
    function isSaneFirstEntry() {
      let d = request.resource.data;
      return d.score <= 50000000
        && d.balance <= 50000000
        && d.netProfit >= -50000000 && d.netProfit <= 50000000;
    }

    // Updates: minimum 2 s since the last accepted write, bounded movement
    // per write, and the best score never goes down. Legacy docs written
    // before these rules may lack fields — treat missing values leniently
    // (the incoming write is still shape-validated and capped above).
    function isSaneUpdate() {
      let d = request.resource.data;
      let prev = resource.data;
      return (!('updatedAt' in prev) || prev.updatedAt == null
              || request.time.toMillis() >= prev.updatedAt.toMillis() + 2000)
        && (!('score' in prev) || !(prev.score is int)
            || (d.score >= prev.score && d.score - prev.score <= 50000000))
        && (!('balance' in prev) || !(prev.balance is int)
            || (d.balance - prev.balance <= 50000000 && prev.balance - d.balance <= 50000000))
        && (!('netProfit' in prev) || !(prev.netProfit is int)
            || (d.netProfit - prev.netProfit <= 50000000 && prev.netProfit - d.netProfit <= 50000000));
    }

    // ── Arcade Cup entries (free-mint competition) ─────────────────────
    // One document per player holding banked tickets. Publicly readable so
    // the site can show the size of the prize pool.
    //
    // These caps ARE the anti-cheat. Tickets buy entries into a draw, not a
    // rank, and `tickets` is hard-capped at 80 — the same ceiling a player
    // who maxes the 10/day allowance every day of the window reaches. There
    // is no number above it to forge, so a script gains nothing a diligent
    // player would not already have. Per-write movement is capped at one
    // day's allowance and rate-limited, so the ceiling also cannot be
    // reached in a single burst.
    //
    // What this does NOT stop is sybils — one person farming several
    // wallets. That shows up in the data; review the drawn winners before
    // allocating mints (scripts/draw-competition.mjs prints the audit).
    match /competition_tickets/{player} {
      allow read: if true;
      allow create: if isValidTicketEntry(player) && request.resource.data.tickets <= 10;
      allow update: if isValidTicketEntry(player) && isSaneTicketUpdate();
    }

    function isValidTicketEntry(playerId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['player', 'name', 'wallet', 'tickets', 'daily', 'progress', 'updatedAt'])
        && d.player is string
        && d.player == playerId
        && d.player.size() >= 1 && d.player.size() <= 64
        && d.name is string && d.name.size() <= 24
        && (d.wallet == null || (d.wallet is string && d.wallet.size() <= 64))
        && d.tickets is int && d.tickets >= 0 && d.tickets <= 80
        && d.daily is map && d.daily.keys().size() <= 14
        && d.progress is map && d.progress.keys().size() <= 4
        && d.updatedAt == request.time;
    }

    // Tickets only ever go up, by at most one day's allowance per write, and
    // no faster than one write every 2 s.
    function isSaneTicketUpdate() {
      let d = request.resource.data;
      let prev = resource.data;
      return (!('updatedAt' in prev) || prev.updatedAt == null
              || request.time.toMillis() >= prev.updatedAt.toMillis() + 2000)
        && (!('tickets' in prev) || !(prev.tickets is int)
            || (d.tickets >= prev.tickets && d.tickets - prev.tickets <= 10));
    }

    // ── The Board (notice board posts) ─────────────────────────────────
    // Publicly readable so every visitor sees the board. Client writes are
    // denied — the team pins new notes from the Firebase console
    // (Firestore → Data → board_posts → Add document). Fields used by the
    // site: title, body, tag, link, linkLabel, image, paper, published,
    // postedAt — see src/services/boardService.ts.
    match /board_posts/{post} {
      allow read: if true;
      allow write: if false;
    }

    // ── Game config (admin-controlled pause / odds) ────────────────────
    // The games subscribe live to game_config/slots and
    // game_config/junk-pusher. Publicly readable; writes only from the
    // Firebase console (or an authenticated admin tool).
    match /game_config/{game} {
      allow read: if true;
      allow write: if false;
    }

    // ── Marketplace listings (legacy trashmarket activity feed) ────────
    // Read-only for the site's activity ticker; written by backend tooling,
    // never from the browser.
    match /gorbagio_listings/{listing} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not matched above is denied by default.
  }
}
